# Copy this file to .env and fill it in yourself. .env is private: never commit it, print it or
# paste it into a chat.

# Your free TMDB "API Read Access Token" (the long one that starts with eyJ, not the short API
# key): https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# Optional: the countries whose streaming offers are kept, as two-letter codes. Set it before the
# build; your own country should be in the list.
# WATCH_REGIONS=US,GB,CA,FR,DE,ES,BE,MA
